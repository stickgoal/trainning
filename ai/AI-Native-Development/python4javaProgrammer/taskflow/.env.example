# 复制为 .env 后按需修改（cp .env.example .env）
# 所有配置项都有默认值，不配也能跑。
#
# 注意 env_prefix：Settings 里配了 env_prefix="TASKFLOW_"，
# 所以这里的键名必须带 TASKFLOW_ 前缀，否则不会被读到。
# .env 已在 .gitignore 中，不会被提交。

# ---- 应用 ----
TASKFLOW_APP_NAME=TaskFlow API
TASKFLOW_APP_ENV=development        # development | testing | production
TASKFLOW_DEBUG=false
TASKFLOW_HOST=127.0.0.1
TASKFLOW_PORT=8000

# ---- 外部「用户服务」（演示 httpx 调用外部 API）----
TASKFLOW_USER_SERVICE_URL=http://127.0.0.1:9999
TASKFLOW_USER_SERVICE_TIMEOUT=2.0
TASKFLOW_USER_SERVICE_ENABLED=false   # false = 跳过校验，离线也能跑

# ---- 限流 ----
TASKFLOW_RATE_LIMIT_MAX_REQUESTS=100
TASKFLOW_RATE_LIMIT_WINDOW_SECONDS=60

# ---- 批量导入 ----
TASKFLOW_MAX_IMPORT_ROWS=1000
